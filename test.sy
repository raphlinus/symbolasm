struct List {
    val: u32
    next: *List
}

fn main(arg0: *i8, arg1: *List) {
    x @r1 = *arg0
    *(arg0 as *i16) = x
    *arg0 = x; arg0 += 8
    x = *arg0; arg0 -= 8
    z @r3 = x >> 1
    z += x
    #(z - 4)
loop:
    #(x -= 1)
    if #eq {
        x = 0
    } else {
        x = 1
    }
    y @r2 = x
    bne loop
    x = y ^ z
    x = y | z
    x = y & z
    x = y << 1
    x = y >> 1
    x = y as i32 >> 1
    x = -y
    x = !y
    x = 1
    x = y + (y << 1)
    x = y + (y >> 1)
    x = y + (y as i32 >> 1)
    x = y[2..5]
    x[11..17] = 0
    x[17..21] = y
    bx lr
}

// comment
fn tuples(p: *u32) {
    val @r1 = 1 // also comment
    val2 @r2 = 2
    *p = (val, val2); p += 8
    *p = (val, val2)
    *p = (val2, val2)
    *p = (val2, val2); p += 12
    *(p + 4) = (val2, val2)
    offset @r3 = 12
    *(p + offset) = (val2, val2)
    (val, val2) = *p
    (val, val2) = *p; p += 8
    (val3 @r3, val) = *p
    (val, val4 @r4) = *p
    val = val3 + val4
}

fn list_len(list: *List) {
    len @r1 = 0
    cbz list, done
loop2:
    val @r2 = list.val
    val += 1
    list.val = val
    list = list.next
    len += 1
    cbnz list, loop2
done:
    r0 = len
    bx lr
}
