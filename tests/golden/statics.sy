// Zero initialized statics and constant folding of literal expressions.

struct Dvi {
    v_scanline: u32
    dma_pong: u32
    frame_count: u32
}

static mut dvi: Dvi
static mut counter: u16

fn bump() {
    p @r0 = &dvi
    pong @r1 = p.dma_pong
    pong ^= 1
    p.dma_pong = pong
    c @r2 = &counter
    n @r3 = *c
    n += 1
    *c = n
    bx lr
}

fn folding() {
    a @r0 = (1 << 8) | (16 << 16) | (2 << 24)
    b @r1 = 20 | (21 << 8)
    c @r2 = b | (1 << 16)
    d @r3 = 0x40038000 + 4 + 4 * 12
    bx lr
}

fn compound(a, b) {
    a &= b
    a |= 0x10
    a ^= b
    a <<= 2
    a >>= b
    a &= !b
    bx lr
}
