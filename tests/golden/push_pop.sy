// push/pop, and moves to the same register being elided.

fn calls_out(a) {
    push(r4, lr)
    saved @r4 = a
    bl elsewhere
    r0 = saved
    pop(r4, pc)
}

fn rename(a) {
    count @r2 = a
    count -= 1
    zero @r2 = count // elided
    zero += 1
    bx lr
}

fn rename_in_it(a) {
    #(a - 1)
    if #eq {
        a = a
    } else {
        a = 2
    }
    bx lr
}

fn irqs() {
    cpsid(i)
    cpsie(i)
    bx lr
}

// A binding in a pop places the variable in the restored register.
fn spill(p: *u32) {
    push(p, lr)
    bl elsewhere
    pop(p @r1, lr)
    *p = r0
    bx lr
}
