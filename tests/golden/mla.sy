// a + b * c is mla and a - b * c is mls, including as += and -=. A power
// of two multiplier is a shifted operand instead.

fn mla(a: u32, b: u32, c: u32) {
    d @r3 = a + b * c
    d = c * b + a
    a += b * c
    a -= b * c
    d = a + b * 4
    bx lr
}

const LINE_BYTES = 1284

fn line_ptr(base: *u32, ix: u32) {
    stride @r2 = LINE_BYTES
    base += ix * stride
    bx lr
}
