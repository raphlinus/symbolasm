// blx calls through a register, here a vtable entry. As with bl, r0-r3,
// r12 and lr are dead after the call, and so are the flags.

struct Vtable {
    start: u32
    render: u32
}

struct DrawObj {
    vtable: *Vtable
}

fn dispatch(obj: *DrawObj) {
    push(r4, lr)
    vt @r1 = obj.vtable
    f @r4 = vt.render
    blx f
    obj @r0 = 0
    f2 @r3 = r4
    blx f2
    pop(r4, pc)
}
